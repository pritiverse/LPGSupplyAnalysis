# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are covered by other .gitignore patterns for Python projects
#  Additional rules:
.build/
selfpyinstaller/

# Pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# Poetry
#   Same as Pipfile.lock, excludes lock file as it is a snapshot of the exact environment at
#   the time it was generated. Committing it can reproduce exact environment, but may cause
#   issues if environment changes.
#poetry.lock

# PEP 582; used by Poetry and mypy
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv/
env/
ENV/

